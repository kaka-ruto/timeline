---
import AppShell from "../../layouts/AppShell.astro";
import { getCollection } from "astro:content";

const writingEntries = await getCollection("writing");
const sortedWritings = writingEntries.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const daysAgoText = (value: Date | string) => {
  const now = new Date();
  const then = new Date(value);
  const diff = Math.max(0, Math.floor((now.getTime() - then.getTime()) / 86400000));
  if (diff === 0) return "today";
  if (diff === 1) return "1 day ago";
  if (diff < 30) return `${diff} days ago`;
  if (diff < 365) return `${Math.floor(diff / 30)} months ago`;
  return `${Math.floor(diff / 365)} years ago`;
};
---

<AppShell activePath="/writing" pageTitle="Writing | Kaka Ruto" pageDescription="Writing by Kaka Ruto.">
  <section class="min-h-screen border-x border-zinc-800 bg-black/95 px-5 py-8 pb-20 lg:pb-8">
    <header class="border-b border-zinc-800 pb-6">
      <h2 class="text-2xl font-bold text-zinc-50">Writing</h2>
      <p class="mt-2 text-zinc-400">Thoughts, notes, and engineering lessons.</p>
    </header>
    
    <div class="-mx-5">
      {sortedWritings.map((entry, i) => (
        <a href={entry.data.url} class:list={["group flex gap-4 px-5 py-5 transition hover:bg-zinc-900/50", i < sortedWritings.length - 1 && "border-b border-zinc-800"]}>
          {entry.data.image && (
            <div class="shrink-0">
              <img src={entry.data.image} alt="" class="h-20 w-28 rounded-lg border border-zinc-800 object-cover transition group-hover:border-zinc-500" />
            </div>
          )}
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline justify-between gap-x-4">
              <h3 class="text-base font-semibold text-zinc-100 transition group-hover:text-sky-400">{entry.data.title}</h3>
              <time class="shrink-0 text-sm text-emerald-400">{daysAgoText(entry.data.date)}</time>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">{entry.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</AppShell>
